{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* @entities → общий каталог доменных Zod-схем web/shared/entities. Он лежит
       вне корня проекта, поэтому bare-импорт zod оттуда не находит node_modules
       кабинета — маппим zod на локальный пакет явно. */
    "paths": {
      "@/*": ["./src/*"],
      "@entities/*": ["../shared/entities/*"],
      "@fields/*": ["../shared/fields/*"],
      "zod": ["./node_modules/zod"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Строгость */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../shared/entities", "../shared/fields"]
}
