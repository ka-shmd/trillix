# Шаблон окружения: документирует КАЖДУЮ переменную. Не читается приложением напрямую —
# рабочий контур копирует нужный файл в .env (`cp .env.dev .env`). Секретов здесь нет,
# только описания и безопасные плейсхолдеры.

# --- HTTP-сервер (читает cmd/api) ---
# Адрес, на котором слушает API. Обязательная.
HTTP_ADDR=127.0.0.1:8080

# Минимальный уровень логирования (debug|info|warn|error). Обязательная. Смысловой
# флаг контура, а не имя окружения: dev — debug (в LogMailer тело dev-письма со
# ссылкой сброса пишется только на debug); prod-local и prod — info, чтобы
# чувствительные тела писем в логи не попадали. Различие контуров живёт здесь.
LOG_LEVEL=info

# Ставить ли флаг Secure на cookie сессии. Обязательная (true|false).
# dev по http → false; prod-local и prod по https → true. Различие контуров
# живёт здесь, а не в ветвлении по имени окружения в коде.
# TODO(фаза 7): при создании .env.prod-local выставить COOKIE_SECURE=true.
COOKIE_SECURE=false

# Стоит ли процесс за доверенным обратным прокси (наш Caddy). Обязательная (true|false).
# true → IP клиента для rate-limit'а берётся из X-Forwarded-For (иначе за прокси все
# клиенты видятся одним IP прокси и один DoS кладёт лимит всем). dev (Go слушает сеть
# напрямую) → false; prod-local и prod (за Caddy) → true. Смысловой флаг, а не имя
# окружения. ВНИМАНИЕ: true только когда снаружи действительно наш прокси — иначе
# клиент подделает X-Forwarded-For и обойдёт лимит.
TRUSTED_PROXY=false

# Путь к файлу справочника геолокации Sypex Geo (SxGeoCity.dat) — из него аналитика
# визитов выводит страну и город. ОПЦИОНАЛЬНАЯ: пусто = гео на контуре нет, блок
# стран и городов в кабинете просто не рисуется (ничего не ломается).
# Файл (~37 МБ) НЕ лежит в репозитории и НЕ входит в образ: он обновляется отдельно
# от кода, раз в год руками — `make geo-fetch` кладёт его в ./geo. На проде путь
# ведёт в примонтированный том. Формат понимает только IPv4 — визиты с IPv6
# остаются без страны, и это видно на экране строкой «Не определено».
GEO_DB_PATH=

# Ключ HMAC-подписи токена времени выдачи публичной формы (антиспам: минимальное
# время заполнения). Обязательная, минимум 16 байт. СЕКРЕТ: в прод-контурах
# генерируется заново (напр. `openssl rand -base64 32`) и живёт только в .env прода,
# не в git. Здесь — только безопасный плейсхолдер.
FORM_TOKEN_SECRET=replace-with-32-random-bytes

# Ключ, из которого выводится СУТОЧНАЯ соль ключа посетителя (карточка «Уникальные»
# в аналитике). ОПЦИОНАЛЬНАЯ: пусто = уникальные не считаются, карточка пуста
# (в лог старта уходит предупреждение). Задана — минимум 16 байт. СЕКРЕТ: в прод-контурах генерируется
# заново (`openssl rand -base64 32`) и живёт только в .env прода.
# Зачем секрет: ключ посетителя = хеш(соль дня ‖ форма ‖ IP ‖ user-agent). Без
# секрета его вычислил бы кто угодно, зная дату и адрес. Соль меняется каждые сутки,
# поэтому вчерашнего посетителя с сегодняшним не связать даже нам.
# ВНИМАНИЕ: смена ключа обнуляет счёт уникальных на стыке — вчерашние ключи станут
# несравнимы с сегодняшними. Это не потеря данных, но число «уникальных» за период,
# накрывающий смену, будет завышено.
ANALYTICS_VISITOR_SECRET=replace-with-32-random-bytes

# Базовый URL публичного рендерера форм. Обязательная, абсолютный http(s)-URL.
# Из него строятся og:url и адрес SPA-скрипта на HTML-странице формы /r/{slug},
# сюда же кабинет даёт ссылку на форму. dev → http://localhost:5174;
# prod-local/prod → https://f.<домен>. Различие контуров живёт здесь.
PUBLIC_RENDERER_BASE_URL=http://localhost:5174

# Абсолютный URL картинки превью ссылок (og:image). Обязательная. В MVP — общая
# брендовая заглушка; своя картинка на форму появится с загрузкой файлов (пост-MVP).
OG_IMAGE_URL=http://localhost:5174/og-preview.png

# Путь в ФС к собранному index.html рендерера. Go читает его при старте и отдаёт как
# страницу формы /r/{slug}, подставляя OG-мету на место плейсхолдера <!--og-meta-->;
# ссылки на ассеты (script/link/preload) берёт из этого HTML как есть (vite сам
# проставил хеши) — Go их не перечисляет. ОПЦИОНАЛЬНАЯ. dev — пусто: собранного HTML
# нет, /r отдаёт vite-dev, Go его не обслуживает. prod-local/prod — /srv/renderer/
# index.html (renderer-статика смонтирована в api read-only, см. deploy/compose.prod.yml).
PUBLIC_RENDERER_INDEX_PATH=

# Origin кабинета (scheme://host[:port], без пути и завершающего слеша) для строгой
# проверки заголовка Origin в CSRF-защите мутаций. Обязательная, http(s)-origin.
# dev — http://localhost:5173 (vite кабинета, чей Origin виден API через proxy);
# prod-local — https://app.localhost; прод — https://app.<домен>.
APP_ORIGIN=http://localhost:5173

# --- Хранилище медиа: S3-совместимое (читает cmd/api; docs/design/s3-media.md) ---
# Провайдеро-независимо: dev/prod-local — локальный MinIO (в Docker), прод —
# арендованное S3. Различие контуров живёт в этих значениях, а не в коде. Приложение
# НЕ подключается к хранилищу на старте — недоступный S3 роняет только загрузки картинок.
# Endpoint (scheme://host[:port], без пути). Обязательная, http(s)-URL.
S3_ENDPOINT=http://127.0.0.1:9000
# Регион подписи sigv4. Обязательная. MinIO игнорирует значение, но подпись его включает — us-east-1.
S3_REGION=us-east-1
# Ключ доступа. Обязательная.
S3_ACCESS_KEY=minioadmin
# Секретный ключ. Обязательная. СЕКРЕТ: в проде генерируется заново, живёт только в .env прода, не логируется.
S3_SECRET_KEY=replace-with-storage-secret
# Бакет public-read картинок. Обязательная.
S3_MEDIA_BUCKET=app-media
# Бакет файлов ответов. Обязательная. ПРИВАТНЫЙ — публичного чтения у него нет и быть
# не должно: файлы респондентов отдаются только по короткой подписи и только вложением.
S3_FILES_BUCKET=app-files
# Адрес хранилища, каким его видит БРАУЗЕР (scheme://host[:port]). Обязательная.
# Обычно совпадает с S3_ENDPOINT; расходятся они там, где Go ходит к хранилищу по
# внутренней сети (prod-local: http://minio:9000 у сервера, http://127.0.0.1:9000 у
# браузера). Имя хоста входит в подпись, поэтому догадаться нельзя.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Path-style адресация (endpoint/bucket/key). Обязательная (true|false). MinIO и часть
# РФ-провайдеров требуют true; AWS virtual-hosted — false.
S3_PATH_STYLE=true

# --- Исходящая транзакционная почта (читает cmd/api; почтовая фаза) ---
# Транспорт доставки писем. Обязательная. Смысловой флаг контура, а не имя окружения.
# Допустимо: "log" — письмо «доставляется» записью в лог (dev, провайдер не нужен);
# "smtp" — реальная отправка по SMTP (прод → Yandex Postbox, prod-local → Mailpit).
MAIL_TRANSPORT=log
# Адрес отправителя в письмах. Обязательная. dev — плейсхолдер; прод — реальный
# адрес на своём домене (SPF/DKIM/DMARC настраиваются в слайсе E, иначе спам).
MAIL_FROM=Trillix <no-reply@localhost>
# Параметры SMTP-транспорта. Обязательны ТОЛЬКО при MAIL_TRANSPORT=smtp (при log
# игнорируются). Один транспорт на оба боевых контура — различие лишь в значениях.
# Хост и порт SMTP-сервера. Прод (Postbox): smtp.<...>, 587. prod-local: mailpit, 1025.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
# Режим TLS: starttls (Postbox, 587) | implicit (465) | none (локальный Mailpit).
MAIL_SMTP_TLS=
# Учётка SMTP. Пусты оба = без аутентификации (Mailpit). Заданы оба = PLAIN (Postbox):
# username — ID статического ключа сервисного аккаунта; password — SMTP-пароль,
# полученный из секрета ключа скриптом-конвертером Яндекса. Секрет — только в .env.
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# --- Build-time переменные фронтов (читает vite build, НЕ приложение Go) ---
# Базовый URL публичной части, зашиваемый в бандл КАБИНЕТА на этапе сборки (ссылка на
# опубликованную форму в UI). Обязательна для прод-сборки (scripts/build-static.sh).
# dev не использует (там vite-dev, значение по умолчанию в коде). prod-local/prod →
# https://f.<домен>. База API кабинета через VITE не задаётся — она относительная
# (/api, same-origin, ADR §10).
VITE_PUBLIC_BASE_URL=https://f.localhost

# --- Домены Caddy (читает deploy/Caddyfile через compose.prod.yml, фаза 7) ---
# Имена двух сайтов прод-контура (ADR §10: кабинет и его API — один origin,
# рендерер — отдельный; выделенного API-домена нет). В dev не используются
# (там vite-proxy, Caddy нет). prod-local — поддомены *.localhost (Caddy выдаёт
# TLS от внутреннего CA); прод — реальные домены (Let's Encrypt). Один Caddyfile на оба.
APP_DOMAIN=app.localhost
RENDERER_DOMAIN=f.localhost

# Раздача картинок /media: Caddy проксирует к объектному хранилищу (same-origin,
# img-src 'self'). Две переменные, потому что смена только S3_* хранилище раздачи
# НЕ покрывает — upstream раздачи задаётся отдельно.
# MEDIA_UPSTREAM — куда Caddy шлёт запрос: scheme://host[:port]. prod-local —
#   http://minio:9000; реальный прод — https://<арендованный-s3-хост>.
# MEDIA_UPSTREAM_HOST — значение заголовка Host к апстриму (host[:port]). Для
#   внешнего path-style S3 обязан быть хостом S3, иначе запрос не сроутится; MinIO
#   его игнорирует. Обычно совпадает с хостом MEDIA_UPSTREAM.
# В dev не используются (Caddy нет, картинки через vite). Path-style (бакет в пути).
MEDIA_UPSTREAM=http://minio:9000
MEDIA_UPSTREAM_HOST=minio:9000

# Срок жизни HSTS (Strict-Transport-Security max-age), в секундах. Читает Caddy.
# prod-local → 0: max-age=0 велит браузеру «забыть HSTS», безвредно на *.localhost
# (год HSTS на localhost запер бы на https все локальные проекты). Реальный прод →
# 31536000 (год) + includeSubDomains: браузер после первого визита ходит только по
# https. В dev не используется (Caddy нет). Различие контуров живёт здесь.
HSTS_MAX_AGE=0

# --- Бэкапы БД (читает deploy/backup.sh на сервере, НЕ приложение Go; фаза 10) ---
# Только прод: cron каждые 6ч снимает pg_dump, шифрует age и льёт в S3 ДРУГОГО
# провайдера, чем медиа (Yandex Object Storage — отказ одного провайдера не уносит
# сразу и данные, и бэкапы). В dev/prod-local не используются. Установка cron,
# генерация ключа age и провижининг бакета — deploy/README.md, раздел «Бэкапы».
# Endpoint Yandex Object Storage. Обязательная (только на проде).
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
# Регион. Опциональная, по умолчанию ru-central1.
BACKUP_S3_REGION=ru-central1
# Ключ и секрет сервис-аккаунта бакета бэкапов. Обязательные (только на проде).
# СЕКРЕТ: живут лишь в .env прода, не в git, не логируются. Отдельные от S3_* медиа.
BACKUP_S3_ACCESS_KEY=replace-with-backup-access-key
BACKUP_S3_SECRET_KEY=replace-with-backup-secret-key
# Приватный бакет для дампов (не public-read, в отличие от медиа). Обязательная.
BACKUP_S3_BUCKET=trillix-backups
# ПУБЛИЧНЫЙ ключ age (age1...), которым сервер шифрует дампы. Обязательная. Не секрет
# сам по себе (шифрует, не расшифровывает); приватный identity на сервере НЕ хранится,
# лежит офлайн у владельца — иначе офсайт-шифрование бессмысленно (deploy/RESTORE.md).
BACKUP_AGE_RECIPIENT=age1replace-with-recipient-public-key

# --- Postgres (читает compose.dev.yml при создании контейнера) ---
# Имя роли, пароль и имя БД для контейнера Postgres. В dev — локальные значения,
# база слушает только 127.0.0.1, наружу не доступна.
POSTGRES_USER=trillix
POSTGRES_PASSWORD=change_me
POSTGRES_DB=trillix

# --- Подключение к БД (будет читать cmd/api с шага 4: раннер миграций) ---
# DSN должен указывать на тот же Postgres, что поднят выше. sslmode=disable — локальный dev.
DATABASE_URL=postgres://trillix:change_me@127.0.0.1:5432/trillix?sslmode=disable

# --- Вход через Яндекс ID (фаза 11) ---
# ОПЦИОНАЛЬНЫЕ и парные: заданы обе — кнопка «Войти через Яндекс» работает,
# не заданы — провайдер выключен целиком (эндпоинты 404, фронт кнопку не рисует).
# Заполнена ровно одна — приложение падает при старте: это опечатка, а не намерение.
# Приложение регистрируется на oauth.yandex.ru; Redirect URI обязан совпасть
# байт в байт с <APP_ORIGIN>/api/v1/auth/oauth/yandex/callback.
# Из доступов нужен только «Адрес электронной почты» (идентификатор /info отдаёт
# всегда) — минимизация ПДн и короткий экран согласия.
# СЕКРЕТ: боевое значение НЕ коммитится. В .env.dev эти строки пустые, реальный
# ключ живёт в локальном .env (он в .gitignore) и в серверном .env прода.
# Приложения для dev и прода — разные: утечка dev-ключа не должна касаться прода.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# --- Google: интеграция формы с Таблицами (фаза 25 DEV-PLAN) ------------------
# Приложение в Google Cloud (OAuth 2.0 client, тип «Web application»). Это НЕ вход:
# им продукт пишет ответы в Таблицу человека от его имени, поэтому набор scope
# другой — openid, email и drive.file (доступ только к созданным нами файлам;
# несенситивный, проверки приложения в Google не требует).
# Redirect URI в консоли обязан совпадать байт в байт с
# <APP_ORIGIN>/api/v1/integrations/google/callback.
# Пусто — интеграция выключена на контуре: таб «Интеграции» живёт, но говорит,
# что здесь она не настроена (dev без проекта в Google Cloud обязан работать).
# СЕКРЕТ: боевое значение НЕ коммитится, приложения dev и прода — разные.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Браузерный API-key того же проекта Google Cloud — для окна выбора файла на
# Диске (Google Picker API; его нужно включить в проекте отдельно). Это НЕ
# секрет приложения: ключ уезжает в браузер по определению, ограничивается в
# консоли по HTTP-referrer и по API.
# Пусто — кнопки «Выбрать на Диске» нет, остальная интеграция работает: создать
# новую таблицу или взять созданную нами.
GOOGLE_PICKER_API_KEY=
