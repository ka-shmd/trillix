# Шаблон окружения: документирует КАЖДУЮ переменную. Не читается приложением напрямую —
# рабочий контур копирует нужный файл в .env (`cp .env.dev .env`). Секретов здесь нет,
# только описания и безопасные плейсхолдеры.

# --- HTTP-сервер (читает cmd/api) ---
# Адрес, на котором слушает API. Обязательная.
HTTP_ADDR=127.0.0.1:8080

# --- Postgres (читает compose.dev.yml при создании контейнера) ---
# Имя роли, пароль и имя БД для контейнера Postgres. В dev — локальные значения,
# база слушает только 127.0.0.1, наружу не доступна.
POSTGRES_USER=trierra
POSTGRES_PASSWORD=change_me
POSTGRES_DB=trierra

# --- Подключение к БД (будет читать cmd/api с шага 4: раннер миграций) ---
# DSN должен указывать на тот же Postgres, что поднят выше. sslmode=disable — локальный dev.
DATABASE_URL=postgres://trierra:change_me@127.0.0.1:5432/trierra?sslmode=disable
