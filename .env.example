# Шаблон окружения: документирует КАЖДУЮ переменную. Не читается приложением напрямую —
# рабочий контур копирует нужный файл в .env (`cp .env.dev .env`). Секретов здесь нет,
# только описания и безопасные плейсхолдеры.

# --- HTTP-сервер (читает cmd/api) ---
# Адрес, на котором слушает API. Обязательная.
HTTP_ADDR=127.0.0.1:8080

# Ставить ли флаг Secure на cookie сессии. Обязательная (true|false).
# dev по http → false; prod-local и prod по https → true. Различие контуров
# живёт здесь, а не в ветвлении по имени окружения в коде.
# TODO(фаза 7): при создании .env.prod-local выставить COOKIE_SECURE=true.
COOKIE_SECURE=false

# Стоит ли процесс за доверенным обратным прокси (наш Caddy). Обязательная (true|false).
# true → IP клиента для rate-limit'а берётся из X-Forwarded-For (иначе за прокси все
# клиенты видятся одним IP прокси и один DoS кладёт лимит всем). dev (Go слушает сеть
# напрямую) → false; prod-local и prod (за Caddy) → true. Смысловой флаг, а не имя
# окружения. ВНИМАНИЕ: true только когда снаружи действительно наш прокси — иначе
# клиент подделает X-Forwarded-For и обойдёт лимит.
TRUSTED_PROXY=false

# Ключ HMAC-подписи токена времени выдачи публичной формы (антиспам: минимальное
# время заполнения). Обязательная, минимум 16 байт. СЕКРЕТ: в прод-контурах
# генерируется заново (напр. `openssl rand -base64 32`) и живёт только в .env прода,
# не в git. Здесь — только безопасный плейсхолдер.
FORM_TOKEN_SECRET=replace-with-32-random-bytes

# Базовый URL публичного рендерера форм. Обязательная, абсолютный http(s)-URL.
# Из него строятся og:url и адрес SPA-скрипта на HTML-странице формы /r/{slug},
# сюда же кабинет даёт ссылку на форму. dev → http://localhost:5174;
# prod-local/prod → https://f.<домен>. Различие контуров живёт здесь.
PUBLIC_RENDERER_BASE_URL=http://localhost:5174

# Абсолютный URL картинки превью ссылок (og:image). Обязательная. В MVP — общая
# брендовая заглушка; своя картинка на форму появится с загрузкой файлов (пост-MVP).
OG_IMAGE_URL=http://localhost:5174/og-preview.png

# Путь в ФС к собранному index.html рендерера. Go читает его при старте и отдаёт как
# страницу формы /r/{slug}, подставляя OG-мету на место плейсхолдера <!--og-meta-->;
# ссылки на ассеты (script/link/preload) берёт из этого HTML как есть (vite сам
# проставил хеши) — Go их не перечисляет. ОПЦИОНАЛЬНАЯ. dev — пусто: собранного HTML
# нет, /r отдаёт vite-dev, Go его не обслуживает. prod-local/prod — /srv/renderer/
# index.html (renderer-статика смонтирована в api read-only, см. deploy/compose.prod.yml).
PUBLIC_RENDERER_INDEX_PATH=

# Origin кабинета (scheme://host[:port], без пути и завершающего слеша) для строгой
# проверки заголовка Origin в CSRF-защите мутаций. Обязательная, http(s)-origin.
# dev — http://localhost:5173 (vite кабинета, чей Origin виден API через proxy);
# prod-local — https://app.localhost; прод — https://app.<домен>.
APP_ORIGIN=http://localhost:5173

# --- Хранилище медиа: S3-совместимое (читает cmd/api; docs/DESIGN-s3-media.md) ---
# Провайдеро-независимо: dev/prod-local — локальный MinIO (в Docker), прод —
# арендованное S3. Различие контуров живёт в этих значениях, а не в коде. Приложение
# НЕ подключается к хранилищу на старте — недоступный S3 роняет только загрузки картинок.
# Endpoint (scheme://host[:port], без пути). Обязательная, http(s)-URL.
S3_ENDPOINT=http://127.0.0.1:9000
# Регион подписи sigv4. Обязательная. MinIO игнорирует значение, но подпись его включает — us-east-1.
S3_REGION=us-east-1
# Ключ доступа. Обязательная.
S3_ACCESS_KEY=minioadmin
# Секретный ключ. Обязательная. СЕКРЕТ: в проде генерируется заново, живёт только в .env прода, не логируется.
S3_SECRET_KEY=replace-with-storage-secret
# Бакет public-read картинок. Обязательная.
S3_MEDIA_BUCKET=app-media
# Path-style адресация (endpoint/bucket/key). Обязательная (true|false). MinIO и часть
# РФ-провайдеров требуют true; AWS virtual-hosted — false.
S3_PATH_STYLE=true

# --- Build-time переменные фронтов (читает vite build, НЕ приложение Go) ---
# Базовый URL публичной части, зашиваемый в бандл КАБИНЕТА на этапе сборки (ссылка на
# опубликованную форму в UI). Обязательна для прод-сборки (scripts/build-static.sh).
# dev не использует (там vite-dev, значение по умолчанию в коде). prod-local/prod →
# https://f.<домен>. База API кабинета через VITE не задаётся — она относительная
# (/api, same-origin, ADR §10).
VITE_PUBLIC_BASE_URL=https://f.localhost

# --- Домены Caddy (читает deploy/Caddyfile через compose.prod.yml, фаза 7) ---
# Имена двух сайтов прод-контура (ADR §10: кабинет и его API — один origin,
# рендерер — отдельный; выделенного API-домена нет). В dev не используются
# (там vite-proxy, Caddy нет). prod-local — поддомены *.localhost (Caddy выдаёт
# TLS от внутреннего CA); прод — реальные домены (Let's Encrypt). Один Caddyfile на оба.
APP_DOMAIN=app.localhost
RENDERER_DOMAIN=f.localhost

# Раздача картинок /media: Caddy проксирует к объектному хранилищу (same-origin,
# img-src 'self'). Две переменные, потому что смена только S3_* хранилище раздачи
# НЕ покрывает — upstream раздачи задаётся отдельно.
# MEDIA_UPSTREAM — куда Caddy шлёт запрос: scheme://host[:port]. prod-local —
#   http://minio:9000; реальный прод — https://<арендованный-s3-хост>.
# MEDIA_UPSTREAM_HOST — значение заголовка Host к апстриму (host[:port]). Для
#   внешнего path-style S3 обязан быть хостом S3, иначе запрос не сроутится; MinIO
#   его игнорирует. Обычно совпадает с хостом MEDIA_UPSTREAM.
# В dev не используются (Caddy нет, картинки через vite). Path-style (бакет в пути).
MEDIA_UPSTREAM=http://minio:9000
MEDIA_UPSTREAM_HOST=minio:9000

# Срок жизни HSTS (Strict-Transport-Security max-age), в секундах. Читает Caddy.
# prod-local → 0: max-age=0 велит браузеру «забыть HSTS», безвредно на *.localhost
# (год HSTS на localhost запер бы на https все локальные проекты). Реальный прод →
# 31536000 (год) + includeSubDomains: браузер после первого визита ходит только по
# https. В dev не используется (Caddy нет). Различие контуров живёт здесь.
HSTS_MAX_AGE=0

# --- Postgres (читает compose.dev.yml при создании контейнера) ---
# Имя роли, пароль и имя БД для контейнера Postgres. В dev — локальные значения,
# база слушает только 127.0.0.1, наружу не доступна.
POSTGRES_USER=trillix
POSTGRES_PASSWORD=change_me
POSTGRES_DB=trillix

# --- Подключение к БД (будет читать cmd/api с шага 4: раннер миграций) ---
# DSN должен указывать на тот же Postgres, что поднят выше. sslmode=disable — локальный dev.
DATABASE_URL=postgres://trillix:change_me@127.0.0.1:5432/trillix?sslmode=disable
