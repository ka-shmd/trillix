# Значения контура prod-local (репетиция прода на *.localhost). Коммитится
# намеренно: это локальная репетиция, все секреты здесь — одноразовые и НЕ
# используются на настоящем проде (там .env генерируется заново на сервере, фаза 9).
# Использование: cp .env.prod-local .env && make prod-local
#
# Отличия от .env.dev — все различия контуров живут здесь, а не в коде:
#   - слушаем 0.0.0.0 (внутри контейнера), а не 127.0.0.1;
#   - COOKIE_SECURE=true (за https от Caddy);
#   - БД по имени docker-сервиса `postgres`, а не 127.0.0.1;
#   - публичная часть на https://f.localhost; страницу формы Go строит из собранного
#     index.html рендерера (PUBLIC_RENDERER_INDEX_PATH, смонтирован в api).

HTTP_ADDR=0.0.0.0:8080
# prod-local — info (как прод): тела писем с токенами в логи не попадают.
LOG_LEVEL=info
COOKIE_SECURE=true
# prod-local: API за Caddy, честный IP клиента — из X-Forwarded-For.
TRUSTED_PROXY=true
GEO_DB_PATH=
# Одноразовый локальный ключ HMAC (НЕ прод-секрет — prod-local репетиция).
FORM_TOKEN_SECRET=PcokXWS2ljhRVe6oLEuDbs4n33pLYyZc1i0Tecd+TJ4=
ANALYTICS_VISITOR_SECRET=dev-only-visitor-salt-secret-not-a-real-key
PUBLIC_RENDERER_BASE_URL=https://f.localhost
OG_IMAGE_URL=https://f.localhost/og-preview.png
# Собранный index.html рендерера, смонтированный в api read-only (compose.prod.yml).
PUBLIC_RENDERER_INDEX_PATH=/srv/renderer/index.html
# Origin кабинета для CSRF Origin-check (https, за Caddy).
APP_ORIGIN=https://app.localhost

# Хранилище медиа: prod-local — MinIO по имени docker-сервиса в сети compose.
# Одноразовые локальные креды (НЕ прод-секрет — на проде .env генерируется заново).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=trillix_media_local
S3_SECRET_KEY=trillix_media_local_pw
S3_MEDIA_BUCKET=app-media
S3_FILES_BUCKET=app-files
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_PATH_STYLE=true

# Почта: prod-local шлёт настоящим SMTP-транспортом (тем же, что уедет на прод) в
# локальный Mailpit — письма видны в его веб-ящике (http://localhost:8025). Так контур
# репетирует боевую отправку, а не суррогат. Mailpit — без TLS и без аутентификации.
MAIL_TRANSPORT=smtp
# Значение закавычено: prod-local источается в шелл (make: `. ./.env.prod-local`),
# где пробелы и «(» без кавычек — синтаксическая ошибка. Кавычки снимают и shell, и
# docker compose --env-file, так что в контейнер приходит чистая строка.
MAIL_FROM="Trillix (prod-local) <no-reply@f.localhost>"
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_TLS=none
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# Домены Caddy (два сайта, ADR §10).
APP_DOMAIN=app.localhost
RENDERER_DOMAIN=f.localhost

# Раздача /media через Caddy: prod-local ходит в MinIO по внутренней сети.
MEDIA_UPSTREAM=http://minio:9000
MEDIA_UPSTREAM_HOST=minio:9000

# HSTS выключен на *.localhost (max-age=0 = «забыть HSTS»): год HSTS на localhost
# запер бы браузер на https для всех локальных проектов. На проде — 31536000.
HSTS_MAX_AGE=0

POSTGRES_USER=trillix
POSTGRES_PASSWORD=trillix_prod_local_pw
POSTGRES_DB=trillix

# Хост БД — имя сервиса в docker-сети compose.prod.yml.
DATABASE_URL=postgres://trillix:trillix_prod_local_pw@postgres:5432/trillix?sslmode=disable

# Build-time (vite build через scripts/build-static.sh): база публичной части в бандле кабинета.
VITE_PUBLIC_BASE_URL=https://f.localhost

# Вход через Яндекс ID: в prod-local обычно выключен (Redirect URI на
# https://app.localhost надо отдельно зарегистрировать в консоли Яндекса).
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
