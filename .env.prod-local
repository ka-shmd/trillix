# Значения контура prod-local (репетиция прода на *.localhost). Коммитится
# намеренно: это локальная репетиция, все секреты здесь — одноразовые и НЕ
# используются на настоящем проде (там .env генерируется заново на сервере, фаза 9).
# Использование: cp .env.prod-local .env && make prod-local
#
# Отличия от .env.dev — все различия контуров живут здесь, а не в коде:
#   - слушаем 0.0.0.0 (внутри контейнера), а не 127.0.0.1;
#   - COOKIE_SECURE=true (за https от Caddy);
#   - БД по имени docker-сервиса `postgres`, а не 127.0.0.1;
#   - публичная часть на https://f.localhost; страницу формы Go строит из собранного
#     index.html рендерера (PUBLIC_RENDERER_INDEX_PATH, смонтирован в api).

HTTP_ADDR=0.0.0.0:8080
COOKIE_SECURE=true
# prod-local: API за Caddy, честный IP клиента — из X-Forwarded-For.
TRUSTED_PROXY=true
# Одноразовый локальный ключ HMAC (НЕ прод-секрет — prod-local репетиция).
FORM_TOKEN_SECRET=PcokXWS2ljhRVe6oLEuDbs4n33pLYyZc1i0Tecd+TJ4=
PUBLIC_RENDERER_BASE_URL=https://f.localhost
OG_IMAGE_URL=https://f.localhost/og-preview.png
# Собранный index.html рендерера, смонтированный в api read-only (compose.prod.yml).
PUBLIC_RENDERER_INDEX_PATH=/srv/renderer/index.html
# Origin кабинета для CSRF Origin-check (https, за Caddy).
APP_ORIGIN=https://app.localhost

# Хранилище медиа: prod-local — MinIO по имени docker-сервиса в сети compose.
# Одноразовые локальные креды (НЕ прод-секрет — на проде .env генерируется заново).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=trierra_media_local
S3_SECRET_KEY=trierra_media_local_pw
S3_MEDIA_BUCKET=app-media
S3_PATH_STYLE=true

# Домены Caddy (два сайта, ADR §10).
APP_DOMAIN=app.localhost
RENDERER_DOMAIN=f.localhost

POSTGRES_USER=trierra
POSTGRES_PASSWORD=trierra_prod_local_pw
POSTGRES_DB=trierra

# Хост БД — имя сервиса в docker-сети compose.prod.yml.
DATABASE_URL=postgres://trierra:trierra_prod_local_pw@postgres:5432/trierra?sslmode=disable

# Build-time (vite build через scripts/build-static.sh): база публичной части в бандле кабинета.
VITE_PUBLIC_BASE_URL=https://f.localhost
