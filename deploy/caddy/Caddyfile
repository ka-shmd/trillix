# Caddy прод-контура (Фаза 7, шаг 3). Один файл для prod-local и прода: домены —
# через env-плейсхолдеры Caddy ({$VAR}), TLS Caddy выбирает по имени сам:
# *.localhost → внутренний CA (prod-local), реальный домен → Let's Encrypt (прод).
# Никакого ветвления по контуру внутри файла.
#
# Две origin, а не три (ADR §10): кабинет и его API — один origin (same-origin,
# без CORS); публичный рендерер — отдельный origin как граница безопасности
# (cookie сессии кабинета туда не попадает). Выделенного API-домена в MVP нет.
#
# Статика фронтов раздаётся напрямую (/srv/static/{app,renderer} из volume);
# в Go проксируется только динамика.

# Заголовки безопасности (шаг 8), общие для обоих сайтов; различия — аргументами:
# {args[0]} = матчер путей, {args[1]} = frame-ancestors, {args[2]} = script-src,
# {args[3]} = frame-src, {args[4]} = connect-src, {args[5]} = добавка к img-src
# (пустая строка — без добавки).
# CSP: скрипты только со своего origin (собранные бандлы без inline-скриптов —
# сильная защита от XSS); 'unsafe-inline' у стилей неизбежен (Radix/dnd-kit пишут
# инлайн-style), но низкориск; всё прочее — 'self'. data: у img/font — иконки/шрифты.
#
# ПОЧЕМУ ПЕРВЫЙ АРГУМЕНТ — МАТЧЕР, А X-Frame-Options ВЫНЕСЕН НАРУЖУ (фаза 20).
# Страница формы `/r/*` встраивается в чужие сайты, остальные пути того же сайта —
# нет, то есть фрейминг стал различаться ВНУТРИ одного сайта, а не только между
# сайтами. Два способа это выразить — оба хуже: продублировать строку CSP в
# отдельном сниппете (две правды об одном списке директив) либо перебивать её
# вторым `header` с матчером (порядок применения двух header-директив к одному
# полю — не то, на что стоит опираться). Отсюда матчер аргументом: список
# заголовков остаётся один, различие — в двух строках вызова.
#
# X-Frame-Options наружу — потому что «разрешить всем» у него выражается ТОЛЬКО
# отсутствием заголовка: значения `ALLOWALL` не существует, а пустая строка даёт
# пустой заголовок. Поэтому он не параметр сниппета, а отдельная директива там,
# где нужен; где не нужен — его просто нет.
#
# ПОЧЕМУ script-src И frame-src ТОЖЕ СТАЛИ АРГУМЕНТАМИ (экран «Встроить»,
# ADR §10). Предпросмотр вставки в кабинете показывает форму НАСТОЯЩИМ сниппетом:
# в макете чужой страницы исполняется тот же `/embed/v1.js` с домена рендерера, а он
# создаёт фрейм на `/r/{slug}` — то есть кабинету нужны оба исключения. Оба заданы
# С ПУТЁМ, и это не аккуратность: с домена рендерера раздаётся `/media/*` с
# пользовательскими загрузками, и `script-src https://f.example` без пути сделал бы
# любой загруженный автором `.js` легальным скриптом на домене, где живёт cookie
# сессии. У рендерера оба остаются `'self'`.
#
# HSTS (TD-13): срок берётся из env {$HSTS_MAX_AGE}, а не хардкодится — иначе
# prod-local на *.localhost запирал бы браузер на https для всего localhost и мешал
# другим локальным проектам. prod-local → HSTS_MAX_AGE=0 (max-age=0 = «забыть HSTS»,
# безвредно на *.localhost); реальный прод → 31536000 (год). Различие живёт в env,
# не в ветвлении по контуру внутри файла.
#
# ⚠ Cross-Origin-Opener-Policy здесь намеренно НЕТ. Вход через провайдера идёт в
# отдельном окне и держится на `window.opener`: заголовок `same-origin` разорвёт
# связь окна со вкладкой при возврате от Яндекса, и окно зависнет молча — ни
# ошибки, ни исхода. Понадобится COOP — только `same-origin-allow-popups`.
(secheaders) {
	header {args[0]} {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE}; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src {args[2]}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {args[5]}; font-src 'self' data:; connect-src {args[4]}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src {args[3]}; frame-ancestors {args[1]}"
		-Server
	}
}

# Проксирование в Go. Выделено в сниппет ради удержания запроса на время
# перезапуска api (фаза 9, шаг 6): выкатка пересоздаёт контейнер, и между
# остановкой старого и готовностью нового отвечать некому. Замер до правки —
# 4 ответа 502 из 281 запроса (scripts/deploy-no-502.sh), то есть выкатка была
# видна пользователю. lb_try_duration заставляет Caddy повторять попытку внутри
# окна вместо мгновенной ошибки.
#
# Graceful shutdown в Go эту щель НЕ закрывает — он лишь докручивает запросы,
# уже принятые старым процессом. Отсюда и лечение на стороне Caddy.
#
# ЧИСЛО ВЗЯТО ИЗ ЗАМЕРА, не из головы (первая версия ставила 10s «с запасом»):
#   - длина щели при перезапуске — 2,07 с (максимальная задержка удержанного
#     запроса из 120; он завершился успешно, ошибок ноль);
#   - при НАСТОЯЩЕЙ смерти api тот же параметр — это время ожидания пользователя
#     до ошибки: 30 параллельных запросов дали 30×502 по ~10,1 с при значении 10s.
# 5s = 2,4× от измеренной щели: запас на медленный старт есть, а ожидание при
# аварии вдвое короче. Caddy держит такие запросы параллельно и статику при этом
# отдаёт за 0,011 с — прокси не деградирует.
#
# ПРО POST: сниппет применяется и к неидемпотентным мутациям кабинета (создание
# формы), поэтому «повтор не создаёт дубль» — не рассуждение, а замер. 40 POST
# /api/v1/forms во время перезапуска api: 40 успехов, в БД ровно 40 форм. Caddy
# повторяет только запросы, которые не успели уйти в апстрим (отказ на соединении);
# уже отправленный POST не переигрывается. Приём ответов и визиты вдобавок
# идемпотентны по клиентскому id, но кабинет — нет, и держится именно на этом.
(apiproxy) {
	reverse_proxy api:8080 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

# Картинки блоков форм — public-read из бакета. Раздаёт Caddy, не Go (байты статики
# Go не отдаёт); тот же origin на обоих сайтах → img-src 'self' покрывает, CORS не
# нужен. Ключи контент-адресны (workspaceID/<sha256>.ext) → иммутабельный кэш.
# handle_path срезает /media, префикс бакета добавляет rewrite (path-style).
# Upstream и Host раздачи — из env (MEDIA_UPSTREAM / MEDIA_UPSTREAM_HOST): prod-local
# → MinIO по внутренней сети, реальный прод (фаза 9) → арендованное S3/CDN (https,
# свой Host, MinIO тогда не поднимается). Host выставляем на хост апстрима — иначе
# внешний S3 не сроутит запрос (бакет уже в пути после rewrite).
(media) {
	handle_path /media/* {
		rewrite * /{$S3_MEDIA_BUCKET}{uri}
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy {$MEDIA_UPSTREAM} {
			header_up Host {$MEDIA_UPSTREAM_HOST}
		}
	}
}

# --- Кабинет: статика + приватный API того же origin ---
{$APP_DOMAIN} {
	encode gzip
	# Кабинет не встраивается никуда и никогда: сюда ходит cookie сессии, и фрейм
	# на чужой странице — это клик-джекинг по живому аккаунту. Ослабление фазы 20
	# сюда не распространяется, на что есть регресс в e2e.
	#
	# Зато САМ кабинет фреймит рендерер — на экране «Встроить» (предпросмотр вставки):
	# отсюда загрузчик в script-src и страница формы в frame-src, оба с путём. Это
	# разрешение НАРУЖУ, а не внутрь: незафреймливаемость кабинета им не затрагивается.
	#
	# Второе разрешение наружу — окно выбора файла на Google Диске (фаза 25):
	# скрипт Picker'а с apis.google.com и его фрейм с docs.google.com. Под scope
	# drive.file «вставьте ссылку на таблицу» не работает в принципе (сервер не
	# видит файл, которого не создавал), а Picker рисует сам Google — своим
	# скриптом в нашем документе. Плата названа в ADR §10: это ТРЕТЬЯ СТОРОНА в
	# origin, где живёт cookie сессии.
	import secheaders * "'none'" "'self' https://{$RENDERER_DOMAIN}/embed/ https://apis.google.com" "'self' https://{$RENDERER_DOMAIN}/r/ https://docs.google.com" "'self' https://apis.google.com" ""
	header * X-Frame-Options DENY

	# Приватный API кабинета — тот же origin, поэтому CORS не нужен, cookie
	# сессии остаётся host-only на этом домене.
	handle /api/* {
		import apiproxy
	}

	# Датчик живости для внешнего мониторинга (фаза 10). Без этого маршрута путь
	# не подпадал ни под одно правило и уезжал в SPA-fallback: снаружи /healthz
	# отдавал 200 и index.html СТАТИКОЙ — то есть мониторинг был бы зелёным даже
	# при мёртвых приложении и базе. Ровно тот дефект, ради которого чинили сам
	# обработчик (TD-7), только снаружи (TD-28).
	#
	# Намеренно БЕЗ import apiproxy: удержание запроса (lb_try_duration) нужно
	# пользовательскому трафику, но вредно датчику — он обязан быстро сказать
	# правду «приложение не отвечает», а не висеть 10 секунд, изображая жизнь.
	handle /healthz {
		reverse_proxy api:8080
	}
	# Картинки блоков (автор видит их в билдере) — same-origin.
	import media
	# Всё остальное — статика кабинета с SPA-fallback.
	handle {
		root * /srv/static/app
		# Хешированные ассеты Vite неизменяемы — кэшируем навсегда.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# --- Публичный рендерер: статика + динамика формы из Go (тот же origin) ---
{$RENDERER_DOMAIN} {
	encode gzip

	# ФРЕЙМИНГ РАЗЛИЧАЕТСЯ ВНУТРИ САЙТА (фаза 20). Страница формы `/r/*` живёт во
	# фрейме на чужих сайтах — блоком, виджетом или на весь экран; всё остальное
	# на этом домене (статика, публичный API, медиа) встраивать незачем, и там
	# остаётся прежний SAMEORIGIN.
	#
	# `frame-ancestors *`, а не список доменов владельца формы — решение владельца
	# 2026-08-05 (design/embed.md §2.2). Размен принят сознательно: чужой сайт
	# может обрамить форму в обманном контексте, но рендерер — ОТДЕЛЬНЫЙ origin
	# без cookie сессии кабинета (ADR §10), поэтому потолок ущерба — накрутка
	# ответов, а не угон аккаунта. Сузить до списка можно позже, не ломая уже
	# вставленные на чужие сайты сниппеты.
	#
	# У `/r/*` X-Frame-Options НЕ ставится вовсе: у него нет значения «разрешить
	# всем», и любое проставленное значение отменило бы `frame-ancestors *` в
	# браузерах, которые смотрят на него первым.
	@embeddable path /r/*
	@chrome not path /r/*
	# connect-src у страницы формы шире на ОДИН источник — хранилище: файл в ответе
	# респондент кладёт туда напрямую по подписи (docs/design/answer-files.md §3),
	# и без этой строки браузер молча заблокирует PUT. Адрес берётся из той же
	# переменной, по которой сервер подписывает адрес, — разъехавшись, они дали бы
	# загрузку, которая падает только в проде.
	#
	# У остальных путей домена (и у всего кабинета) connect-src остаётся 'self':
	# писать в хранилище незачем никому, кроме страницы формы.
	#
	# Счётчик Яндекс Метрики автора (фаза 29, ADR §10) — тоже только у `/r/*`. tag.js
	# грузится с mc.yandex.ru, а хиты шлёт на региональное зеркало посетителя сразу тремя
	# путями: XHR (connect-src), картинки (img-src) и JSONP-скрипт (script-src). Поэтому
	# у всех трёх директив один и тот же список — зеркала mc.yandex.* из справки Метрики
	# про CSP. Не пропущены намеренно: адреса вебвизора (mc.webvisor.*, wss://) — его у нас
	# нет; yastatic.net — счётчику без вебвизора не нужен (замер на prod-local), а в
	# script-src открыл бы CDN чужих библиотек. Правишь список — правь все три места.
	# В консоли страницы формы остаются три отказа CSP, и они ожидаемы: вебсокет
	# `wss://mc.yandex.*/solid.ws`, фрейм `mc.yandex.*` и `eval` из tag.js. Хиты и цели
	# идут мимо них; открывать connect-src под wss, frame-src и 'unsafe-eval' незачем.
	import secheaders @embeddable "*" "'self' https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz" "'self'" "'self' {$S3_PUBLIC_ENDPOINT} https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz" "https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz"
	import secheaders @chrome "'self'" "'self'" "'self'" "'self'" ""
	header @chrome X-Frame-Options SAMEORIGIN

	# HTML-документ формы с OG-мета — из Go (краулеры читают <head> без JS).
	handle /r/* {
		import apiproxy
	}
	# Публичный API формы и приём ответа — рендерер зовёт относительным путём,
	# поэтому проксируем same-origin (CORS не нужен).
	handle /public/* {
		import apiproxy
	}
	# Картинки блоков (респондент видит их в форме) — same-origin.
	import media
	# Всё остальное — статика рендерера с SPA-fallback.
	handle {
		root * /srv/static/renderer
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Загрузчик встроенной формы (фаза 20) — НЕ immutable, в отличие от ассетов
		# рядом: у него имя без хеша (`/embed/v1.js` вписан в сниппеты на чужих
		# сайтах и меняться не может), поэтому вечный кэш означал бы «правка
		# загрузчика доедет до чужого сайта никогда». Десять минут — компромисс:
		# почти вся выгода кэша при внятном сроке раскатки исправления.
		header /embed/* Cache-Control "public, max-age=600"
		try_files {path} /index.html
		file_server
	}
}
