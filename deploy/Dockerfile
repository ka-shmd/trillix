# Multi-stage сборка API-образа (Фаза 7, шаг 1). Один и тот же образ гоняет
# сервер (ENTRYPOINT без аргументов) и миграции (`api migrate up`) — бинарник
# несёт миграции внутри через go:embed (migrations.FS), поэтому исходники и
# компилятор в рантайм-образ не попадают.

# --- Сборка ---------------------------------------------------------------
# Версия builder'а совпадает с go.mod (go 1.26): расхождение сломало бы сборку
# на новых конструкциях языка/стандартной библиотеки.
FROM golang:1.26 AS builder
WORKDIR /src

# Слой зависимостей кэшируется отдельно: пересобирается только при смене
# go.mod/go.sum, а не при каждой правке кода.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO_ENABLED=0 → полностью статический бинарник (работает в distroless/static,
# где нет libc). -s -w выкидывают отладочную информацию ради размера.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /api ./cmd/api

# --- Рантайм --------------------------------------------------------------
# distroless/static: нет shell, пакетного менеджера и лишних бинарей — минимум
# поверхности атаки. Тег nonroot запускает процесс под непривилегированным UID.
FROM gcr.io/distroless/static:nonroot
COPY --from=builder /api /api
EXPOSE 8080
ENTRYPOINT ["/api"]
