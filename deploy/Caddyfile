# Caddy прод-контура (Фаза 7, шаг 3). Один файл для prod-local и прода: домены —
# через env-плейсхолдеры Caddy ({$VAR}), TLS Caddy выбирает по имени сам:
# *.localhost → внутренний CA (prod-local), реальный домен → Let's Encrypt (прод).
# Никакого ветвления по контуру внутри файла.
#
# Статика фронтов раздаётся напрямую (/srv/static/{app,renderer} из volume, шаг 4);
# в Go проксируется только динамика. Заголовки безопасности (CSP/nosniff/frame)
# добавляются отдельно в шаге 8.

# --- Кабинет: чистая статика (в API ходит кросс-доменно на {$API_DOMAIN}) ---
{$APP_DOMAIN} {
	encode gzip
	root * /srv/static/app
	# Хешированные ассеты Vite неизменяемы — кэшируем навсегда.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# SPA-fallback: любой неизвестный путь отдаёт index.html (клиентский роутинг).
	try_files {path} /index.html
	file_server
}

# --- Публичный рендерер: статика + динамика формы из Go (тот же origin) ---
{$RENDERER_DOMAIN} {
	encode gzip

	# HTML-документ формы с OG-мета — из Go (краулеры читают <head> без JS).
	handle /r/* {
		reverse_proxy api:8080
	}
	# Публичный API формы и приём ответа — рендерер зовёт относительным путём,
	# поэтому проксируем same-origin (CORS не нужен).
	handle /public/* {
		reverse_proxy api:8080
	}
	# Всё остальное — статика рендерера с SPA-fallback.
	handle {
		root * /srv/static/renderer
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# --- Приватный API кабинета (кросс-доменные запросы с {$APP_DOMAIN}) ---
{$API_DOMAIN} {
	reverse_proxy api:8080
}
