# Значения dev-контура. Коммитится в репозиторий намеренно: пароль — локальный,
# одноразовый, база слушает только 127.0.0.1. Настоящие секреты живут в .env прода (не в git).
# Использование: cp .env.dev .env
HTTP_ADDR=127.0.0.1:8080
# dev — debug: видно тело dev-письма из LogMailer (ссылка сброса для локального теста).
LOG_LEVEL=debug
COOKIE_SECURE=false
# dev: Go слушает сеть напрямую, X-Forwarded-For не доверяем.
TRUSTED_PROXY=false
# Справочник геолокации. Пусто = страны и города в аналитике выключены (блок не
# рисуется). Чтобы включить: `make geo-fetch` и прописать geo/SxGeoCity.dat.
# ВНИМАНИЕ: на dev визиты приходят с 127.0.0.1, у локального адреса страны нет —
# данные на экране появятся только от `make seed` или с настоящего контура.
GEO_DB_PATH=
# Локальный одноразовый ключ HMAC (не настоящий секрет — dev-контур).
FORM_TOKEN_SECRET=dev-only-form-token-secret-not-a-real-key
PUBLIC_RENDERER_BASE_URL=http://localhost:5174
OG_IMAGE_URL=http://localhost:5174/og-preview.png
# Печать PDF в dev (ADR §10). Контейнер принтера поднимает compose.dev.yml в
# хостовой сети, поэтому адрес локальный. PRINT_PAGE_PATH нужен потому, что путь к
# печатной странице в проде выводится из собранного index.html рендерера, а в dev
# его нет вовсе (форму отдаёт vite). Саму страницу собирает `make dev-all`
# (npm run build:print) — правишь её вид, пересобери: vite её не обслуживает.
PRINTER_URL=http://127.0.0.1:8090
PRINT_PAGE_PATH=web/renderer/dist/print/print.html


# PUBLIC_RENDERER_INDEX_PATH намеренно не задан: в dev собранного index.html нет,
# страницу формы /r/{slug} отдаёт vite-dev — Go её не обслуживает (в проде задан).
# Origin кабинета: в dev это vite :5173 (его Origin API видит через proxy).
APP_ORIGIN=http://localhost:5173

# Хранилище медиа: dev — локальный MinIO (make dev поднимает его в Docker вместе с Postgres).
# Значения — одноразовые локальные (не настоящий секрет).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_MEDIA_BUCKET=app-media
S3_FILES_BUCKET=app-files
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_PATH_STYLE=true

# Почта: dev «доставляет» письма в лог (провайдер не нужен для локальной разработки).
MAIL_TRANSPORT=log
MAIL_FROM=Trillix (dev) <no-reply@localhost>

POSTGRES_USER=trillix
POSTGRES_PASSWORD=trillix_dev_pw
POSTGRES_DB=trillix

DATABASE_URL=postgres://trillix:trillix_dev_pw@127.0.0.1:5432/trillix?sslmode=disable

# Вход через Яндекс ID: пусто — провайдер выключен, кабинет работает как раньше.
# Свои ключи от dev-приложения впишите в локальный .env (cp .env.dev .env),
# а не сюда: этот файл в репозитории.
YANDEX_OAUTH_CLIENT_ID=64f7bb178d244457bb95fb1c3419c700
YANDEX_OAUTH_CLIENT_SECRET=2aecd9709d3c47d8a5e7adb400c7ea74

# Приложение Google Cloud для интеграции с Таблицами (фаза 25). Здесь ПУСТО
# намеренно: client secret Google — секрет, и место ему в локальном .env
# (он в .gitignore), а не в коммите. Пусто = интеграция выключена на контуре.
# Redirect URI в консоли: http://localhost:5173/api/v1/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Браузерный ключ для окна выбора файла на Диске (Google Picker API).
# Не секрет — но и здесь пусто: dev-контур работает без него, только без кнопки
# «Выбрать на Диске».
GOOGLE_PICKER_API_KEY=
