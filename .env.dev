# Значения dev-контура. Коммитится в репозиторий намеренно: пароль — локальный,
# одноразовый, база слушает только 127.0.0.1. Настоящие секреты живут в .env прода (не в git).
# Использование: cp .env.dev .env
HTTP_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
# Локальный одноразовый ключ HMAC (не настоящий секрет — dev-контур).
FORM_TOKEN_SECRET=dev-only-form-token-secret-not-a-real-key
PUBLIC_RENDERER_BASE_URL=http://localhost:5174
OG_IMAGE_URL=http://localhost:5174/og-preview.png
# dev: entry рендерера отдаёт vite-dev как исходник (в проде — собранный /renderer.js).
PUBLIC_RENDERER_SCRIPT_PATH=/src/main.tsx
# PUBLIC_RENDERER_STYLE_PATH намеренно не задан: в dev vite инжектит CSS через JS.
# Origin кабинета: в dev это vite :5173 (его Origin API видит через proxy).
APP_ORIGIN=http://localhost:5173

POSTGRES_USER=trierra
POSTGRES_PASSWORD=trierra_dev_pw
POSTGRES_DB=trierra

DATABASE_URL=postgres://trierra:trierra_dev_pw@127.0.0.1:5432/trierra?sslmode=disable
